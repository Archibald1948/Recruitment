# ── 노션 ────────────────────────────────────────────────
# 서버 전용. 클라이언트에 절대 노출 금지
NOTION_TOKEN=

# 지원자 관리 DB
NOTION_DATABASE_ID=
# 선택: data source id를 직접 지정하면 조회 요청을 한 번 아낀다
NOTION_DATA_SOURCE_ID=

# Q&A 문의 게시판 DB
NOTION_QNA_DATABASE_ID=
NOTION_QNA_DATA_SOURCE_ID=

# 사이트 설정 DB — 모집 마감일을 여기서 읽는다.
# 노션에서 날짜만 고치면 재배포 없이 최대 60초 안에 사이트에 반영된다.
NOTION_SETTINGS_DATABASE_ID=
NOTION_SETTINGS_DATA_SOURCE_ID=

# ── 메일 ────────────────────────────────────────────────
# 둘 중 설정된 쪽이 자동으로 쓰인다. RESEND_API_KEY가 있으면 그쪽이 우선.
# 둘 다 없으면 접수는 정상 처리되고 수정 링크만 서버 콘솔에 남는다.

# 1) Gmail SMTP — 도메인이 필요 없다
#    Google 계정에 2단계 인증을 켠 뒤 앱 비밀번호를 발급받는다
#    https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# 발신 표시 이름. 비우면 site.name을 쓴다
MAIL_FROM_NAME="Build It, Ship It Together"

# 2) Resend — 도메인 SPF/DKIM 검증 후 갈아끼운다. 도달률이 더 좋다
RESEND_API_KEY=
MAIL_FROM="Build It, Ship It Together <noreply@builditship.kro.kr>"

# ── 링크 ────────────────────────────────────────────────
# 매직 링크 절대 URL 생성용. 비우면 Vercel 배포 URL을 쓴다
APP_URL=http://localhost:3000

# ── 운영자 ──────────────────────────────────────────────
# /admin 잠금 해제 키. 화면에서 이 값을 입력하면 8시간짜리 세션 쿠키가 발급된다.
# 길이가 곧 방어력이다(192비트): openssl rand -base64 24
# 비워두면 운영자 화면이 열리지 않는다(깜빡한 배포에서 목록이 열리는 것보다 낫다).
# 운영자 화면 입구가 되는 비밀 경로(한 조각). 예: ops-3f9a1c
# /admin 은 이 값과 무관하게 항상 404다. 비우면 입구가 아예 없다.
ADMIN_PATH=

ADMIN_TOKEN=

# ── 기타 ────────────────────────────────────────────────
# 수정 토큰 해시용 시크릿: openssl rand -base64 32
TOKEN_PEPPER=

# 마감일 최후 기본값. 평소에는 노션(사이트 설정 DB)의 값이 쓰이고,
# 노션을 읽지 못할 때만 이 값으로 떨어진다. 미설정 시 config 기본값.
NEXT_PUBLIC_DEADLINE=
