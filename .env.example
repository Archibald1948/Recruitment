# ── 노션 ────────────────────────────────────────────────
# 서버 전용. 클라이언트에 절대 노출 금지
NOTION_TOKEN=
NOTION_DATABASE_ID=
# 선택: data source id를 직접 지정하면 조회 요청을 한 번 아낀다
NOTION_DATA_SOURCE_ID=

# ── 메일 ────────────────────────────────────────────────
# 둘 중 설정된 쪽이 자동으로 쓰인다. RESEND_API_KEY가 있으면 그쪽이 우선.

# 1) Gmail SMTP — 도메인이 필요 없다
#    Google 계정에 2단계 인증을 켠 뒤 앱 비밀번호를 발급받는다
#    https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME="Build It, Ship It Together"

# 2) Resend — 도메인을 확보한 뒤 갈아끼운다. 도달률이 더 좋다
RESEND_API_KEY=
MAIL_FROM="Build It, Ship It Together <noreply@example.com>"

# 문의 메일 수신처 + 지원 접수 메일의 회신 주소 (팀장 주소)
# 저장소가 공개라 코드에 넣지 않는다
CONTACT_EMAIL=

# ── 링크 ────────────────────────────────────────────────
# 매직 링크 절대 URL 생성용. 커스텀 도메인을 붙이면 여기도 바꾼다
APP_URL=http://localhost:3000

# ── 기타 ────────────────────────────────────────────────
# 수정 토큰 해시용 시크릿: openssl rand -base64 32
TOKEN_PEPPER=

# 마감일만 바꿀 때는 코드가 아니라 이 값을 고친다 (미설정 시 config 기본값)
NEXT_PUBLIC_DEADLINE=
