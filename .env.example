# Notion — 서버 전용. 클라이언트에 절대 노출 금지
NOTION_TOKEN=
NOTION_DATABASE_ID=
# 선택: data source id를 직접 지정하면 조회 요청을 한 번 아낀다
NOTION_DATA_SOURCE_ID=

# Resend — 접수 확인 + 수정 링크 발송
RESEND_API_KEY=
MAIL_FROM="팀 프로젝트 <noreply@example.com>"

# 매직 링크 절대 URL 생성용
APP_URL=http://localhost:3000

# 수정 토큰 해시용 시크릿: openssl rand -base64 32
TOKEN_PEPPER=

# 마감일만 바꿀 때는 코드가 아니라 이 값을 고친다 (미설정 시 config 기본값)
NEXT_PUBLIC_DEADLINE=
